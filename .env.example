# StoryDuett Environment Configuration (D1 Solo)
PORT=3000
NODE_ENV=development
# Gemini API Key for server-side generation (prioritizes non-empty SD_GEMINI_API_KEY, else GEMINI_API_KEY)
SD_GEMINI_API_KEY=
GEMINI_API_KEY=
# Optional server-side killswitch (default is true; set to false to disable provider key resolution and signal ready=false)
SD_AI_ENABLED=true

