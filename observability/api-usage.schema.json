{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private API usage record, not for public user data",
  "type": "object",
  "required": [
    "requestId",
    "feature",
    "model",
    "status",
    "startedAt",
    "priceListVersion"
  ],
  "properties": {
    "requestId": {
      "type": "string"
    },
    "sessionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "userId": {
      "type": [
        "string",
        "null"
      ]
    },
    "feature": {
      "enum": [
        "start",
        "turn",
        "tts",
        "cartoon",
        "chat",
        "summary"
      ]
    },
    "model": {
      "type": "string"
    },
    "promptVersionIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "success",
        "error",
        "blocked"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "latencyMs": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "inputTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "outputTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "thinkingTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cachedTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "audioTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "estimatedCostUsd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "priceListVersion": {
      "type": "string"
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "chargedUsd": {
      "type": "number",
      "minimum": 0
    },
    "reservedUsd": {
      "type": "number",
      "minimum": 0
    },
    "totalTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "modelVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "providerResponseId": {
      "type": [
        "string",
        "null"
      ]
    },
    "promptHash": {
      "type": "string"
    },
    "errorInfoReason": {
      "enum": [
        "API_KEY_INVALID",
        "API_KEY_SERVICE_BLOCKED",
        "API_KEY_ANDROID_APP_BLOCKED",
        "API_KEY_HTTP_REFERRER_BLOCKED",
        "API_KEY_IP_ADDRESS_BLOCKED",
        "API_KEY_IOS_APP_BLOCKED",
        "API_KEY_EXPIRED",
        "API_KEY_NOT_FOUND",
        "SERVICE_DISABLED",
        "ACCESS_TOKEN_EXPIRED",
        "ACCESS_TOKEN_SCOPE_INSUFFICIENT",
        "RATE_LIMIT_EXCEEDED",
        "USER_PROJECT_DENIED",
        "CONSUMER_INVALID",
        "BILLING_DISABLED",
        null
      ]
    }
  }
}
